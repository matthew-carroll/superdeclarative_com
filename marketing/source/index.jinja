            <h2 class="text-[#F7F8FC] font-bold text-4xl md:text-5xl tracking-tight leading-tight">My Work</h2>
            <p class="mt-3 text-[#A1A1AA] text-lg md:text-xl font-normal tracking-normal">Custom Flutter Widgets</p>
          </div>

          <div class="work">
            {% for widget in work.widgets %}
            <figure class="work-item work-item--{{ widget.key }}">
              <div class="work-tile">
                <video
                  class="work-video"
                  src="videos/demo_{{ widget.key }}.mp4"
                  poster="images/work/{{ widget.key }}.jpg"
                  aria-label="{{ widget.name }} widget, running"
                  loop
                  muted
                  playsinline
                  preload="none"
                ></video>
                <button type="button" class="work-toggle" aria-label="Play {{ widget.name }} animation">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path class="work-toggle-play" d="M8 5.5v13a.8.8 0 0 0 1.2.7l10.3-6.5a.8.8 0 0 0 0-1.4L9.2 4.8A.8.8 0 0 0 8 5.5Z" />
                    <path class="work-toggle-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" />
                  </svg>
                </button>
              </div>
              <figcaption class="work-caption">
                <h3 class="work-name">{{ widget.name }}.</h3>
                <p class="work-description">{{ widget.description }}</p><br>
                <a href="https://www.youtube.com/watch?v={{ widget.episode }}" target="_blank" rel="noopener" class="work-link" data-play="{{ widget.episode }}">Watch me build it</a>
              </figcaption>
            </figure>
            {% endfor %}
