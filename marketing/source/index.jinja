<!doctype html>

<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{  title  }}</title>
    <meta name="description" content="{{ description }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href="{{ homepage_url }}/">

    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png">
    <link rel="manifest" href="/images/favicon/site.webmanifest">
    <link rel="mask-icon" href="/images/favicon/safari-pinned-tab.svg" color="#5bbad5">
    <link rel="shortcut icon" href="/images/favicon/favicon.ico">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="msapplication-config" content="/images/favicon/browserconfig.xml">
    <meta name="theme-color" content="#141417">

    <!-- Open Graph Social Media -->
    <meta property="og:url" content="{{ homepage_url }}/" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:image" content="{{ homepage_url }}/images/social.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SuperDeclarative! AI Infused App Development. Flutter, Android, iOS, Mac, and web. A hooded figure with glowing red eyes stands behind a ring of golden energy that carries the Claude, Codex, Flutter, Antigravity, and Grok Bot icons." />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@SuprDeclarative" />
    <meta name="twitter:url" content="{{ homepage_url }}/" />
    <meta name="twitter:title" content="{{ title }}" />
    <meta name="twitter:description" content="{{ description }}" />
    <meta name="twitter:image" content="{{ homepage_url }}/images/social.jpg" />
    <meta name="twitter:image:alt" content="SuperDeclarative! AI Infused App Development. Flutter, Android, iOS, Mac, and web. A hooded figure with glowing red eyes stands behind a ring of golden energy that carries the Claude, Codex, Flutter, Antigravity, and Grok Bot icons." />

    <link href="styles/tailwind.css" rel="stylesheet">
  </head>

  <body class="w-full bg-[#1C1C21] text-[#FFFFFF88]">

    <!-- Contact popup. Styles live in source/styles/tailwind.css under "Contact". -->
    <dialog id="hireMeModal" class="contact" aria-labelledby="contactHeading">
      <div class="contact-stage">
        <div class="contact-figure" aria-hidden="true">
          <img src="images/hero_character.webp" alt="" width="1024" height="338" class="contact-character">

          <!-- Spans from hand to hand, and charges up as the form is completed -->
          <svg class="contact-ring" viewBox="0 -80 1024 418" fill="none">
            <defs>
              <linearGradient id="contactRingGradient" x1="100" y1="0" x2="924" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#FF8A00" stop-opacity="0" />
                <stop offset="0.1" stop-color="#FFB800" />
                <stop offset="0.5" stop-color="#FFED4B" />
                <stop offset="0.9" stop-color="#FFB800" />
                <stop offset="1" stop-color="#FF8A00" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="contactRingCore" x1="100" y1="0" x2="924" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0.08" stop-color="#FFFDF2" stop-opacity="0" />
                <stop offset="0.35" stop-color="#FFFDF2" stop-opacity="0.8" />
                <stop offset="0.65" stop-color="#FFFDF2" stop-opacity="0.8" />
                <stop offset="0.92" stop-color="#FFFDF2" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="contactRingTrack" x1="100" y1="0" x2="924" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#8E8E98" stop-opacity="0" />
                <stop offset="0.12" stop-color="#8E8E98" stop-opacity="0.45" />
                <stop offset="0.88" stop-color="#8E8E98" stop-opacity="0.45" />
                <stop offset="1" stop-color="#8E8E98" stop-opacity="0" />
              </linearGradient>
              <filter id="contactRingGlow" x="-40" y="-160" width="1104" height="320" filterUnits="userSpaceOnUse">
                <feGaussianBlur stdDeviation="11" />
              </filter>
            </defs>
            <path d="M100 48A412 100 0 0 1 924 48" stroke="url(#contactRingTrack)" stroke-width="2" />
            <g class="contact-ring-lit">
              <path class="contact-ring-charge" d="M100 48A412 100 0 0 1 924 48" pathLength="1" stroke="url(#contactRingGradient)" stroke-width="14" filter="url(#contactRingGlow)" />
              <path class="contact-ring-charge" d="M100 48A412 100 0 0 1 924 48" pathLength="1" stroke="url(#contactRingGradient)" stroke-width="5" />
              <path class="contact-ring-charge" d="M100 48A412 100 0 0 1 924 48" pathLength="1" stroke="url(#contactRingCore)" stroke-width="1.6" />
            </g>
          </svg>
        </div>

        <div class="contact-card">
          <button type="button" id="contactClose" class="contact-close" aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
          </button>

          <form id="hireMeForm" class="contact-form" novalidate>
            <h2 id="contactHeading" class="contact-heading" tabindex="-1">Let&#39;s talk work</h2>
            <p class="contact-intro">Tell me what you&#39;re building and where you need help.</p>

            <div class="contact-fields">
              <div class="contact-field">
                <label for="contactName">Name</label>
                <input type="text" id="contactName" name="name" autocomplete="name" aria-describedby="contactNameError">
                <p id="contactNameError" class="contact-error">Add your name.</p>
              </div>
              <div class="contact-field">
                <label for="contactEmail">Email</label>
                <input type="email" id="contactEmail" name="email" autocomplete="email" inputmode="email" aria-describedby="contactEmailError">
                <p id="contactEmailError" class="contact-error">Enter an email address I can reply to.</p>
              </div>
              <div class="contact-field contact-field--wide">
                <label for="contactMessage">What can I help you with?</label>
                <textarea id="contactMessage" name="message" rows="4" aria-describedby="contactMessageError"></textarea>
                <p id="contactMessageError" class="contact-error">Tell me a little about what you need.</p>
              </div>
            </div>

            <p id="contactFailure" class="contact-failure" role="alert" hidden>Your message didn&#39;t send, but it&#39;s still here. Try again, or message <a href="https://x.com/SuprDeclarative" target="_blank" rel="noopener">@SuprDeclarative</a> on X.</p>

            <button type="submit" id="contactSend" class="contact-send">Send message</button>
          </form>

          <div id="contactSent" class="contact-sent" hidden>
            <h2 id="contactSentHeading" class="contact-heading" tabindex="-1">Message sent</h2>
            <p class="contact-intro">Thanks, <span id="contactSentName"></span>. I&#39;ll reply to <span id="contactSentEmail" class="contact-sent-email"></span>.</p>
            <button type="button" id="contactDone" class="contact-send">Done</button>
          </div>
        </div>
      </div>
    </dialog>

