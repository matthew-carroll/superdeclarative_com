      <section id="community" class="pt-[72px] md:pt-[112px] pb-[72px] md:pb-[112px]">
        <div class="container max-w-[1000px] px-[24px] min-[1048px]:px-[0px]">
          <div class="text-center">
            <h2 class="text-[#F7F8FC] font-bold text-4xl md:text-5xl tracking-tight leading-tight">Community</h2>
            <p class="mt-3 text-[#A1A1AA] text-lg md:text-xl font-normal tracking-normal">Hosting Shows &amp; Building Packages</p>
          </div>

          <!-- Shows. Styles live in source/styles/tailwind.css under "Shows". -->
          <div class="mt-16 md:mt-20">
            <h3 class="community-heading">Shows &amp; talks</h3>
            <p class="community-intro">No secrets here. Watch me build on camera and teach on stage.</p>

            <div id="shows" class="shows">
              <div class="shows-stage">
                {% for show in shows %}
                {% for video in show.videos %}
                {% if video.featured %}
                <div id="showsScreen" class="shows-screen">
                  <a id="showsPoster" href="https://www.youtube.com/watch?v={{ video.id }}" target="_blank" rel="noopener" class="shows-poster" aria-label="Play {{ video.title }}">
                    <img src="images/live-coding/{{ video.image }}.jpg" alt="" width="1280" height="720" loading="lazy">
                    <svg class="shows-play" viewBox="0 0 72 72" aria-hidden="true">
                      <circle cx="36" cy="36" r="36" />
                      <path d="M29 23.5v25a1.5 1.5 0 0 0 2.3 1.3l19.5-12.5a1.5 1.5 0 0 0 0-2.6L31.3 22.200A1.5 1.5 0 0 0 29 23.5Z" />
                    </svg>
                  </a>
                </div>
                <div class="shows-caption" aria-live="polite">
                  <div id="showsTitle" class="shows-title">{{ video.title }}</div>
                  <p id="showsDescription" class="shows-description">{{ video.description }}</p>
                  <a id="showsLink" href="https://www.youtube.com/watch?v={{ video.id }}" target="_blank" rel="noopener" class="shows-youtube">Watch on YouTube</a>
                </div>
                {% endif %}
                {% endfor %}
                {% endfor %}
              </div>

              <div class="shows-list">
                {% for show in shows %}
                <div class="shows-group">
                  <h4 class="shows-name">
                    <span class="shows-name-text">{{ show.name }}</span>
                    <button type="button" class="shows-expand" aria-expanded="true">
                      <span>{{ show.name }}</span>
                      <span class="shows-count">{{ show.videos | length }}<span class="visually-hidden"> videos</span></span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                  </h4>
                  <div class="shows-fold">
                  <ul class="shows-videos">
                    {% for video in show.videos %}
                    <li>
                      <a
                        href="https://www.youtube.com/watch?v={{ video.id }}"
                        target="_blank"
                        rel="noopener"
                        class="shows-video"
                        data-video="{{ video.id }}"
                        data-title="{{ video.title }}"
                        data-description="{{ video.description }}"
                        {% if video.featured %}aria-current="true"{% endif %}
                      >
                        <img src="images/live-coding/{{ video.image }}-small.jpg" alt="" width="256" height="144" loading="lazy" class="shows-thumb">
                        <span class="shows-text">
                          <span class="shows-label">{{ video.label }}</span>
                          <span class="shows-length">{% if video.year %}<span class="shows-year">{{ video.year }}</span>{% endif %}{{ video.length }}</span>
                        </span>
                      </a>
                    </li>
                    {% endfor %}
                  </ul>
                  </div>
                </div>
                {% endfor %}
              </div>
            </div>
          </div>

          <!-- Open source packages. Styles live in source/styles/tailwind.css under "Packages". -->
