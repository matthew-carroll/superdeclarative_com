        >
          <img src="images/icons/android-studio.webp" alt="Android Studio" class="hero-ring-icon absolute top-0 left-1/2 w-[57px] h-[57px] min-[1200px]:w-[76px] min-[1200px]:h-[76px] will-change-transform select-none" />
          <img src="images/icons/flutter.webp" alt="Flutter" class="hero-ring-icon absolute top-0 left-1/2 w-[57px] h-[57px] min-[1200px]:w-[76px] min-[1200px]:h-[76px] will-change-transform select-none" />
          <img src="images/icons/vscode.webp" alt="VSCode" class="hero-ring-icon absolute top-0 left-1/2 w-[57px] h-[57px] min-[1200px]:w-[76px] min-[1200px]:h-[76px] will-change-transform select-none" />
          <img src="images/icons/ios.webp" alt="iOS" class="hero-ring-icon absolute top-0 left-1/2 w-[57px] h-[57px] min-[1200px]:w-[76px] min-[1200px]:h-[76px] will-change-transform select-none" />
          <img src="images/icons/xcode.webp" alt="XCode" class="hero-ring-icon absolute top-0 left-1/2 w-[57px] h-[57px] min-[1200px]:w-[76px] min-[1200px]:h-[76px] will-change-transform select-none" />
